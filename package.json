    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.mjs",
    "db:seed-mcq": "node prisma/seed.mjs --mcq-only"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@clerk/nextjs": "^6.0.0",
    "@google/genai": "^2.24.0",
    "@prisma/client": "6.19.3",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "pdfjs-dist": "6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
