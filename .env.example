# Clerk authentication (Phase 2)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Public site URL (set to your deployed origin)
NEXT_PUBLIC_APP_URL=

# Neon PostgreSQL: pooled URL for application queries, direct URL for migrations.
DATABASE_URL=
DIRECT_URL=

# Google Gemini (Phase 6)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Private resume storage. Use local only for local development.
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
